<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ActuadorActivity">

  <!-- Titulo de la Activity -->
  <TextView
      android:id="@+id/titulo_control"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="32dp"
      android:layout_marginTop="50dp"
      android:layout_marginEnd="32dp"
      android:text="PANEL DE CONTROL"
      android:textAlignment="center"
      android:textColor="#114d94"
      android:textSize="25sp"
      android:textStyle="bold"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <!-- ========================================= -->
  <!-- CONTROL DEL SENSOR -->
  <!-- ========================================= -->
  <TextView
      android:id="@+id/label_sensor"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="32dp"
      android:layout_marginTop="80dp"
      android:layout_marginEnd="16dp"
      android:text="Sensor de Movimiento"
      android:textSize="20sp"
      android:textStyle="bold"
      app:layout_constraintEnd_toStartOf="@+id/switch_sensor"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/titulo_control" />

  <Switch
      android:id="@+id/switch_sensor"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="32dp"
      android:text="Apagado  "
      android:textColor="#757575"
      android:textSize="16sp"
      app:layout_constraintBottom_toBottomOf="@+id/label_sensor"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="@+id/label_sensor" />

  <!-- ========================================= -->
  <!-- CONTROL LED 1 -->
  <!-- ========================================= -->
  <TextView
      android:id="@+id/label_led1"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="32dp"
      android:layout_marginTop="50dp"
      android:layout_marginEnd="16dp"
      android:text="Iluminación LED 1"
      android:textSize="20sp"
      android:textStyle="bold"
      app:layout_constraintEnd_toStartOf="@+id/switch_led1"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/label_sensor" />

  <Switch
      android:id="@+id/switch_led1"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="32dp"
      android:text="Apagado  "
      android:textColor="#757575"
      android:textSize="16sp"
      app:layout_constraintBottom_toBottomOf="@+id/label_led1"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="@+id/label_led1" />

  <!-- ========================================= -->
  <!-- CONTROL LED 2 -->
  <!-- ========================================= -->
  <TextView
      android:id="@+id/label_led2"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="32dp"
      android:layout_marginTop="50dp"
      android:layout_marginEnd="16dp"
      android:text="Iluminación LED 2"
      android:textSize="20sp"
      android:textStyle="bold"
      app:layout_constraintEnd_toStartOf="@+id/switch_led2"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/label_led1" />

  <Switch
      android:id="@+id/switch_led2"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="32dp"
      android:text="Apagado  "
      android:textColor="#757575"
      android:textSize="16sp"
      app:layout_constraintBottom_toBottomOf="@+id/label_led2"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="@+id/label_led2" />

  <!-- ========================================= -->
  <!-- BOTÓN VOLVER -->
  <!-- ========================================= -->
  <Button
      android:id="@+id/btn_volver"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="64dp"
      android:layout_marginEnd="64dp"
      android:layout_marginBottom="50dp"
      android:backgroundTint="#F00000"
      android:padding="12dp"
      android:text="Volver"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>