<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/text_nombre_proyecto"
        android:layout_width="344dp"
        android:layout_height="74dp"
        android:text="SISTEMA DE ALARMA POR MOVIMIENTO"
        android:textAlignment="center"
        android:textColor="#114d94"
        android:textSize="25dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_editor_absoluteY="105dp" />

    <TextView
        android:layout_width="344dp"
        android:layout_height="0dp"
        android:text="Integrantes"
        android:textSize="20dp"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_editor_absoluteY="500dp" />

    <TextView
        android:layout_width="344dp"
        android:layout_height="50dp"
        android:text="Benjamín Rojas y Kevin Valdivia"
        android:textAlignment="center"
        android:textSize="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_editor_absoluteY="537dp" />

    <Button
        android:id="@+id/btn_avanzar"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:text="Siguiente"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_editor_absoluteY="650dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>